FROM apache/airflow:3.2.2

USER root

RUN apt-get update && \
    apt-get install -y gcc g++ && \
    apt-get clean

USER airflow

# Só as bibliotecas do pipeline/treino: FastAPI e Pydantic ficam com as versões
# que o próprio Airflow já traz, para não conflitar com ele.
COPY requirements-pipeline.txt /requirements.txt

RUN pip install --no-cache-dir --upgrade pip

RUN pip install --no-cache-dir -r /requirements.txt